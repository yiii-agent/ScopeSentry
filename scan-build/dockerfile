# ScopeSentry-Scan 扫描端 arm64 版
# 基于官方 dockerfile(Autumn-27/ScopeSentry-Scan 仓库根目录的 dockerfile),
# 差异:二进制与 4 个内置工具(katana/rad/rustscan/ksubdomain)均为 arm64。
#
# 注意:本目录下的 dist/、msyh.ttc、tools/linux/ 不入库,
# 由 scripts/build-arm64.sh 从 ScopeSentry-Scan 源码与官方 release 组装生成:
#   - dist/ScopeSentry-Scan_linux_arm64_v1/ScopeSentry-Scan   (扫描端二进制)
#   - msyh.ttc                                                (中文字体,取自 Scan 仓库)
#   - tools/linux/{katana,rad,rustscan,ksubdomain}            (arm64 工具)
FROM python:3.7-slim

WORKDIR /apps
COPY msyh.ttc /usr/share/fonts/

RUN apt-get update && apt-get install -y \
    libexif-dev \
    udev \
    chromium \
    vim \
    tzdata \
    libpcap-dev \
    default-jdk \
    && rm -rf /var/lib/apt/lists/*

RUN pip install uro

COPY dist/ScopeSentry-Scan_linux_arm64_v1/ScopeSentry-Scan /apps/ScopeSentry-Scan
RUN chmod +x /apps/ScopeSentry-Scan
RUN mkdir /apps/ext
RUN mkdir /apps/ext/rad
RUN mkdir /apps/ext/ksubdomain
RUN mkdir /apps/ext/rustscan
RUN mkdir /apps/ext/katana

COPY tools/linux/ksubdomain /apps/ext/ksubdomain/ksubdomain
RUN chmod +x /apps/ext/ksubdomain/ksubdomain
COPY tools/linux/rad /apps/ext/rad/rad
RUN chmod +x /apps/ext/rad/rad
COPY tools/linux/rustscan /apps/ext/rustscan/rustscan
RUN chmod +x /apps/ext/rustscan/rustscan

COPY tools/linux/katana /apps/ext/katana/katana
RUN chmod +x /apps/ext/katana/katana

RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime
RUN echo 'Asia/Shanghai' >/etc/timezone

# go-rod(httpx 截图/katana,v0.116.2)在 arm64 上无法在线下载浏览器:
# 它要求缓存路径 ~/.cache/rod/browser/chromium-1124/chrome(arm64 用 playwright 1124,
# 二进制名固定为 chrome),把 apt 安装的 chromium 链接过去(已实测通过其 --dump-dom 校验)
RUN mkdir -p /root/.cache/rod/browser/chromium-1124 /root/.cache/rod/browser/chromium-1321438 && \
    ln -sf /usr/bin/chromium /root/.cache/rod/browser/chromium-1124/chrome && \
    ln -sf /usr/bin/chromium /root/.cache/rod/browser/chromium-1321438/chrome

ENV LANG C.UTF-8

ENTRYPOINT ["/apps/ScopeSentry-Scan"]
