# ScopeSentry arm64 部署环境变量模板
# 用法:cp .env.example .env && 按下方命令生成强随机密码,或参考 docs/arm64-build.md
# 生成: MONGO_PW=$(openssl rand -hex 16) && REDIS_PW=$(openssl rand -hex 16)
# 注意:.env 含真实凭据,已被 .gitignore 忽略,严禁提交
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me_strong_password
REDIS_PASSWORD=change_me_strong_password
